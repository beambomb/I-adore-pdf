# Copy to .env and adjust. Docker Compose reads .env automatically.
# .env is git-ignored. Never commit real credentials.

# --- Login (HTTP Basic). Set BOTH to turn it on; leave both empty for no login. ---
# Required before exposing the app beyond your own machine.
AUTH_USERNAME=
AUTH_PASSWORD=

# --- Limits ---
MAX_FILE_MB=50
MAX_TOTAL_MB=200
# Processed files are deleted this many seconds after they are created.
JOB_TTL_SECONDS=1800
# Maximum POST requests per client per minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=120

# --- Behind a reverse proxy (Nginx, Caddy, a platform router, ...) ---
# Only set to true when a proxy you control sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Browser access from a different website (rarely needed) ---
# Comma-separated list, e.g. https://pdf.example.com
CORS_ORIGINS=
